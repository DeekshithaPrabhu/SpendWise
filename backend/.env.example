# Password reset emails. Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password> (Google Account > Security > App passwords).
# Password reset emails (optional). If SMTP_HOST is empty, the reset link is printed
# in the API console instead of being emailed (handy for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SpendWise <no-reply@spendwise.app>"
